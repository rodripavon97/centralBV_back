# Variables de entorno para producción (Docker/servidor).
# Copiar a .env.production o inyectar vía Docker Compose/plataforma.
# NO versionar archivos con secretos reales.

NODE_ENV=production
PORT=3000

# Supabase (cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# JWT
JWT_SECRET=replace-with-a-long-random-jwt-secret

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=replace-with-mail-user
MAIL_PASS=replace-with-mail-pass
MAIL_FROM="CentralBV <no-reply@centralbv.com>"

# Frontend de recuperación (debe estar permitido en Supabase Auth)
PASSWORD_RESET_REDIRECT_URL=https://app.example.com/update-password

# true solo detrás de proxy/CDN confiable
TRUST_PROXY=true

# AES-256-GCM: 64 chars hex (32 bytes)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-64-hex-chars
